      "html": "<nav class=\"ds-nav\" aria-label=\"Asosiy navigatsiya\"><a href=\"#maktab\">Maktab haqida</a><a href=\"#talim\">Ta’lim</a><a href=\"#galereya\">Galereya</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:28px;color:var(--ink);font-family:var(--font-body),sans-serif}.ds-nav a{position:relative;display:inline-flex;align-items:center;min-height:44px;color:inherit;font-size:13px;font-weight:500;line-height:1.65;white-space:nowrap;text-decoration:none}.ds-nav a::after{content:'';position:absolute;inset-inline:0;bottom:7px;height:1px;background:currentColor;transform:scaleX(0);transform-origin:left;transition:transform .25s var(--ease)}.ds-nav a:hover::after,.ds-nav a:focus-visible::after{transform:scaleX(1)}.ds-nav a:focus-visible{outline:2px solid currentColor;outline-offset:6px}@media(prefers-reduced-motion:reduce){.ds-nav a::after{transition-duration:.01ms}}"
