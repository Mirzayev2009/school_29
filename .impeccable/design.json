  "narrative": {
    "northStar": "A welcoming school prospectus",
    "overview": "Warm paper, forest-green ink, expressive serif headings, and substantial school-life photography create an approachable editorial identity. The page feels open and human: photographs carry the atmosphere, while clear Uzbek copy and restrained controls help visitors explore.\n\nThe implementation is flat and spacious. Alternating paper and forest surfaces establish rhythm without floating panels or decorative effects. The identity follows the user's approved ivory, green, serif, and photography direction. The displayed school name, people, figures, events, location, and photographs remain demo material; they are not evidence of a real school's identity or achievements. The opening hero is a full-viewport cover photograph beneath light text and transparent navigation, with a static dark scrim for contrast. The navigation returns to paper after the hero and when its mobile menu is open. The contact area includes the user-requested full example address and three clearly labeled demo contact links: phone, Telegram, and Instagram.",
    "keyCharacteristics": [
      "Warm ivory and forest surfaces with a full-viewport photographic hero.",
      "Bodoni Moda headings with Manrope reading and control text.",
      "Rectangular photography and open editorial articles.",
      "Fine dividing rules and lightly rounded controls.",
      "One coordinated introduction, followed by useful interaction feedback."
    ],
    "rules": [
      {
        "name": "The Paired Surface Rule",
        "body": "A forest surface uses the on-green text roles and green rules; a paper surface uses ink, muted ink, and paper rules. Hero photography uses on-green text with the contrast scrim.",
        "section": "colors"
      },
      {
        "name": "The Editorial Pairing Rule",
        "body": "Serif type belongs to major headings, school figures, and the footer motto; reading text and interactive labels use Manrope.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Preserve the flat article and section treatment; depth comes from tonal separation and the modal backdrop.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do pair each surface with its matching text and rule roles.",
      "Do use Bodoni Moda for major headings and Manrope for reading and controls.",
      "Do preserve open photo-and-caption groups, aligned edges, and generous section space.",
      "Do preserve keyboard access, visible focus, dialog focus return, and reduced-motion support.",
      "Do keep demo people, figures, photos, and location visibly identified until replaced with verified school material."
    ],
    "donts": [
      "Don't replace rectangular photography with a repeated grid of rounded floating panels.",
      "Don't add decorative shadows to the flat section and article system.",
      "Don't treat sample school details or stock photography as verified school facts.",
      "Don't leave the hero's temporary animation mask clipping the completed heading."
    ]
  }
}
