      "css": ".ds-learning-surface{background:var(--forest);color:var(--on-green);}.ds-tab{display:grid;grid-template-columns:1fr auto 20px;align-items:center;gap:20px;width:100%;padding:24px 0;border:0;border-bottom:1px solid #52705c;background:transparent;color:var(--on-green-muted);font-family:var(--font-body),sans-serif;font-size:18px;font-weight:400;line-height:1.65;text-align:left;cursor:pointer}.ds-tab[aria-selected=true]{color:var(--white)}.ds-tab[aria-selected=true]>span:first-child{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:8px}.ds-tab .ds-range{font-size:13px;white-space:nowrap}.ds-tab svg{width:20px;height:20px;opacity:0;transition:opacity .2s}.ds-tab[aria-selected=true] svg,.ds-tab:hover svg{opacity:1}.ds-tab:focus-visible{outline:2px solid currentColor;outline-offset:6px}@media(prefers-reduced-motion:reduce){.ds-tab svg{transition-duration:.01ms}}"
