      "html": "<a class=\"ds-button\" href=\"#maktab\">Maktab bilan tanishing <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M6 18 18 6M6 6h12v12\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></a>",
